{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WanderTrade world map",
  "type": "object",
  "required": ["version", "worldSchema", "viewBox", "terrain", "cities", "roads"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "worldSchema": { "type": "integer", "minimum": 1 },
    "viewBox": {
      "type": "object",
      "required": ["width", "height"],
      "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "editor": {
      "type": "object",
      "properties": {
        "hexGrid": {
          "type": "object",
          "properties": {
            "orientation": { "const": "flat" },
            "size": { "type": "number", "minimum": 10, "maximum": 100 },
            "columns": { "type": "integer", "minimum": 1, "maximum": 200 },
            "rows": { "type": "integer", "minimum": 1, "maximum": 200 },
            "visible": { "type": "boolean" },
            "snap": { "type": "boolean" }
          }
        }
      }
    },
    "cities": { "type": "array", "items": { "$ref": "#/$defs/city" } },
    "roads": { "type": "array", "items": { "$ref": "#/$defs/road" } },
    "terrain": {
      "type": "object",
      "properties": {
        "seed": { "type": "integer" },
        "gridStep": { "type": "number", "exclusiveMinimum": 0 },
        "contourLevels": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 } },
        "features": { "type": "array", "items": { "$ref": "#/$defs/terrainFeature" } },
        "hex": { "$ref": "#/$defs/terrainHexOverrides" }
      }
    },
    "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
    "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } }
  },
  "$defs": {
    "city": {
      "type": "object",
      "required": ["id", "name", "tier", "x", "y", "goods"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["village", "town", "capital", "frontier", "special"] },
        "x": { "type": "number" }, "y": { "type": "number" },
        "layer": { "type": "string" },
        "goods": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "road": {
      "type": "object",
      "required": ["id", "from", "to", "travelDistance", "economicDistance"],
      "properties": {
        "id": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" },
        "travelDistance": { "type": "number", "exclusiveMinimum": 0 },
        "economicDistance": { "type": "number", "exclusiveMinimum": 0 },
        "enabled": { "type": "boolean" }, "hidden": { "type": "boolean" },
        "layer": { "type": "string" },
        "curve": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["auto", "straight", "manual", "hex", "control", "branch"] },
            "bend": { "type": "number", "minimum": 0 },
            "controls": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/point" } },
            "controlPoint": { "$ref": "#/$defs/point" },
            "controlPoints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/point" } },
            "hexPath": { "type": "array", "items": { "$ref": "#/$defs/point" } },
            "hexWaypoints": { "type": "array", "items": { "$ref": "#/$defs/point" } },
            "branchPoint": { "$ref": "#/$defs/point" },
            "group": { "type": "string" }
          }
        }
      }
    },
    "point": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "layer": {
      "type": "object", "required": ["id", "name"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "visible": { "type": "boolean" } }
    },
    "region": {
      "type": "object", "required": ["id", "name", "cityIds"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "cityIds": { "type": "array", "items": { "type": "string" } } }
    },
    "terrainFeature": {
      "type": "object", "required": ["id", "type", "amplitude"],
      "properties": {
        "id": { "type": "string" }, "type": { "enum": ["gaussian", "ridge"] }, "anchor": { "type": "string" },
        "amplitude": { "type": "number" }, "offset": { "$ref": "#/$defs/point" }, "radius": { "$ref": "#/$defs/point" },
        "from": { "$ref": "#/$defs/point" }, "to": { "$ref": "#/$defs/point" }, "width": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "terrainHexOverrides": {
      "type": "object",
      "properties": {
        "hexSize": { "type": "number", "minimum": 10, "maximum": 100 },
        "overrides": {
          "type": "object",
          "properties": {
            "tiles": {
              "type": "object",
              "patternProperties": { "^-?\\d+,-?\\d+$": { "$ref": "#/$defs/terrainHexOverride" } },
              "additionalProperties": false
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "match": { "$ref": "#/$defs/terrainHexMatch" },
                  "set": { "$ref": "#/$defs/terrainHexOverride" },
                  "spec": { "$ref": "#/$defs/terrainHexOverride" }
                }
              }
            }
          }
        }
      }
    },
    "terrainHexMatch": {
      "type": "object",
      "properties": {
        "terrain": { "oneOf": [ { "$ref": "#/$defs/terrainHexName" }, { "type": "array", "items": { "$ref": "#/$defs/terrainHexName" } } ] },
        "landform": { "oneOf": [ { "enum": ["water", "plain", "hill"] }, { "type": "array", "items": { "enum": ["water", "plain", "hill"] } } ] }
      }
    },
    "terrainHexName": { "enum": ["water", "grass", "field", "forest", "flower", "ridge", "city"] },
    "terrainHexOverride": {
      "type": "object",
      "properties": {
        "terrain": { "$ref": "#/$defs/terrainHexName" },
        "landform": { "enum": ["water", "plain", "hill"] },
        "locked": { "type": "boolean" },
        "blocked": { "type": "boolean" },
        "mountain": {
          "type": "object",
          "properties": {
            "style": { "enum": ["auto", "lonePeak", "twinPeak", "massif", "ridge", "valleyPeak", "landmark"] },
            "heightScale": { "type": "number", "minimum": 0, "maximum": 4 },
            "landmark": { "type": "boolean" },
            "valley": { "type": ["string", "boolean"] }
          }
        },
        "waterway": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["auto", "mountainGorge", "mountainPass", "waterfall", "blocked", "dryValley"] },
            "radius": { "type": "number" },
            "depth": { "type": "number" },
            "width": { "type": "number" }
          }
        },
        "waterVisual": { "type": "object" }
      }
    }
  }
}
